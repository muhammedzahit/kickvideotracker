{
  "manifest_version": 3,
  "name": "Kick VOD Kaldığın Yer",
  "short_name": "Kick Tracker",
  "version": "1.0.0",
  "description": "Kick'te eski yayınları (VOD) izlerken kaldığın dakikayı kaydeder ve geri döndüğünde oradan devam ettirir.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kick VOD Kaldığın Yer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*", "https://www.kick.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
